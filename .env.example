# Copiá este archivo a .env y completá los valores entre < >. El .env NUNCA se sube a git.
#   cp .env.example .env
# Las marcadas [OBLIGATORIA] no tienen valor por defecto en el código: si faltan, la API no
# arranca y el error dice cuál completar. (Los comentarios van siempre en su propia línea.)

# --- Modelo de chat (cualquier endpoint compatible con la API de OpenAI) ---
# [OBLIGATORIA] key de OpenAI o de Gemini (Google AI Studio)
OPENAI_API_KEY=<tu-key-de-openai-o-de-gemini>
# Endpoint compatible con OpenAI. Para Gemini gratis, este; vacío = OpenAI.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# [OBLIGATORIA] modelo por defecto de todos los roles
OPENAI_MODEL=gemini-flash-lite-latest
# Modelo por rol (si no están, se usa OPENAI_MODEL). Con el free tier de Gemini conviene
# repartir: la cuota (por día y por minuto) se cuenta por modelo.
SUPERVISOR_MODEL=gemini-flash-lite-latest
RESEARCH_MODEL=gemini-3.5-flash-lite
ANALYST_MODEL=gemini-3.1-flash-lite
SYNTH_MODEL=gemini-3.1-flash-lite
# Alternativo de la síntesis si el principal falla (429 de cuota, 5xx, timeout). Con el free tier de
# Gemini la cuota es por modelo, así que el alternativo tiene la suya. Vacío = sin fallback.
SYNTH_FALLBACK_MODEL=gemini-flash-lite-latest
# Pedidos por minuto POR MODELO (free tier de Gemini: ~5 RPM). Vacío = sin límite.
LLM_RPM=4
# Salida estructurada del supervisor: json_schema (default), function_calling o json_mode.
# SUPERVISOR_STRUCTURED_METHOD=json_schema
# Precios para el costo estimado de cada respuesta (US$ por millón de tokens), en JSON. Son los de
# la tabla de modelos de Arize Phoenix 20.21.1: así el costo de la API coincide con el del dashboard.
# Con el free tier de Gemini el gasto real es 0; esto estima lo que costaría pagando. Si un modelo
# no está, la respuesta lo avisa en metricas.modelos_sin_precio.
PRECIOS_LLM={"gemini-flash-lite-latest": {"entrada_usd_por_millon": 0.3, "salida_usd_por_millon": 2.5}, "gemini-3.5-flash-lite": {"entrada_usd_por_millon": 0.3, "salida_usd_por_millon": 2.5}, "gemini-3.1-flash-lite": {"entrada_usd_por_millon": 0.25, "salida_usd_por_millon": 1.5}, "gemini-flash-latest": {"entrada_usd_por_millon": 0.75, "salida_usd_por_millon": 3.75}, "gpt-4o-mini": {"entrada_usd_por_millon": 0.15, "salida_usd_por_millon": 0.6}}
# Segundos máximos por pedido al modelo (un timeout se reintenta como error transitorio).
# LLM_TIMEOUT_S=90

# --- Embeddings y Pinecone (capa RAG) ---
# [OBLIGATORIA] el mismo modelo con el que se hizo la ingesta
EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=1536
# [OBLIGATORIA]
PINECONE_API_KEY=<tu-key-de-pinecone>
# [OBLIGATORIA] índice serverless (p. ej. el de la Pre-entrega 4). Si no existe, la API lo crea y sube el corpus al arrancar.
INDEX_NAME=<nombre-del-indice>
# [OBLIGATORIA] namespace del corpus (p. ej. caudal-docs)
PINECONE_NAMESPACE=<namespace-del-corpus>
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# RAG_TOP_K=5
# RAG_PESO_VECTOR=0.5
# Al arrancar: si el índice no existe o el namespace está vacío, se crea y se sube el corpus de data/.
# RAG_AUTO_INGESTA=true

# --- Redis: jobs, cola del worker y checkpoints de LangGraph (necesita JSON + Search: redis:8) ---
# Con docker compose la API usa redis://redis:6379/0 (lo pisa el compose); con run.sh, este.
REDIS_URL=redis://localhost:6379/0
# REDIS_PREFIJO=final
# Vencimiento del estado de cada job en Redis, en segundos (los checkpoints de las conversaciones no vencen).
# JOB_TTL_S=604800

# --- Worker y grafo ---
# Jobs a la vez dentro del proceso de la API.
WORKER_CONCURRENCY=5
# 0 = la API solo encola y los jobs los corre `uv run python -m app.worker` en otro proceso.
# WORKER_EMBEBIDO=1
# Pasos máximos del supervisor por turno y turnos previos de la conversación que ve.
# MAX_STEPS=6
# TURNOS_DE_CONTEXTO=3

# --- Seguridad: quién aprueba las tareas críticas (human-in-the-loop) ---
# Revisores y sus claves, en JSON. POST /tasks/{id}/approve exige el header X-Reviewer-Key con una de
# estas claves y registra el nombre del dueño. Sin revisores, nadie puede aprobar (503): seguro por defecto.
# Nombres en minúsculas; claves de 16+ caracteres. Generá una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
REVIEWER_KEYS={"ana": "<clave-de-ana-de-16-o-mas-caracteres>"}

# --- Observabilidad: Arize Phoenix (OpenInference) ---
# Con docker compose la API usa http://phoenix:6006/v1/traces (lo pisa el compose); con run.sh, este.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=entrega-final
# TRACING_ENABLED=0 apaga las trazas.
# TRACING_ENABLED=1
# LOG_LEVEL=INFO
